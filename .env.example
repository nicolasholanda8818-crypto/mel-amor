SECRET_KEY=troque-por-um-segredo-longo

# Banco permanente. Use uma URL PostgreSQL de Neon, Supabase, Vercel Postgres ou outro provedor.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Uploads permanentes. Use Cloudinary para fotos, vídeos e músicas não sumirem.
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
